# ============================================================
#  라이트팩토리 백엔드 환경변수 — 복사 후 .env 로 저장
# ============================================================

# ── Supabase PostgreSQL ──────────────────────────────────────
# Supabase > Settings > Database > Connection string > Transaction mode (포트 6543)
DATABASE_URL="postgresql://postgres.[ref]:[pw]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase > Connection string > Session mode (포트 5432) — 마이그레이션용
DIRECT_URL="postgresql://postgres.[ref]:[pw]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ── JWT ─────────────────────────────────────────────────────
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET="변경필수-32자이상-랜덤문자열"
JWT_REFRESH_SECRET="변경필수-32자이상-랜덤문자열-다른값"

# ── 토스페이먼츠 ─────────────────────────────────────────────
TOSS_SECRET_KEY="test_sk_..."      # 테스트: test_sk_ / 운영: live_sk_
TOSS_WEBHOOK_SECRET="webhook-secret"

# ── 카카오 알림톡 (알리고) ────────────────────────────────────
KAKAO_API_KEY="aligo-api-key"
KAKAO_USER_ID="aligo-user-id"
KAKAO_SENDER_KEY="kakao-sender-key"
KAKAO_SENDER_PHONE="0212345678"

# ── 이메일 (Resend) ──────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="no-reply@lightfactory.co.kr"

# ── Cloudflare R2 이미지 저장 ────────────────────────────────
R2_ACCOUNT_ID="account-id"
R2_ACCESS_KEY_ID="access-key"
R2_SECRET_ACCESS_KEY="secret-key"
R2_BUCKET_NAME="lightfactory-images"
R2_PUBLIC_URL="https://cdn.lightfactory.co.kr"

# ── CORS (프론트엔드 도메인) ─────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,https://lightfactory.co.kr"

# ── Vercel Cron 인증 ─────────────────────────────────────────
# 매일 오후 2시(KST=05:00 UTC) 이카운트 자동 전송 크론(/api/cron/ecount-send)에서 사용
CRON_SECRET="openssl-rand-base64-32-결과값"

# ── 이카운트 ERP OAPI (판매 자동 등록) ───────────────────────
# 발급: 이카운트 로그인 > 셀프서비스 > API 인증 > 인증키 발급
# ⚠️ 미설정 시 실제 호출 없이 시뮬레이션으로 전표번호만 발번합니다.
ECOUNT_COM_CODE="회사코드"
ECOUNT_USER_ID="OAPI 사용자 ID"
ECOUNT_API_CERT_KEY="API 인증키"
ECOUNT_ZONE="접속 ZONE (예: CA)"
ECOUNT_API_MODE="test"             # test(평가판 sboapi) | live(운영 oapi)
ECOUNT_CUST_CODE="매출 거래처 코드"   # 이카운트 거래처 마스터와 일치 필요
ECOUNT_WH_CODE=""                  # 출고 창고 코드(선택)

# ── 관리자 초기 비밀번호 (시드 실행 시 사용) ─────────────────
ADMIN_PW="Lightfactory2025!"
NODE_ENV="development"

# ── 네이버 커머스 API (스마트스토어 연동) ─────────────────────
# 발급 경로: apicenter.commerce.naver.com → 내 스토어 애플리케이션 → 애플리케이션 등록
# ⚠️ 인증 기한: 약 2주 — 만료 전 커머스 API 센터에서 수동 인증 갱신 필요
NAVER_COMMERCE_CLIENT_ID="애플리케이션 ID"
NAVER_COMMERCE_CLIENT_SECRET="애플리케이션 시크릿"
NAVER_STORE_ID="스마트스토어 채널 ID (숫자)"
